# Copy to .env and adjust. Never commit .env.

# development (default) | demo | production
# production: debug off, a private DJANGO_SECRET_KEY is required (setup.bat generates it),
# and demo-data commands refuse to run.
HELPLY_ENVIRONMENT=development

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave POSTGRES_DB unset to use local SQLite. With PostgreSQL in Docker: run "docker compose up -d db" first.
POSTGRES_DB=helply
POSTGRES_USER=helply
POSTGRES_PASSWORD=helply

HELPLY_AI_BACKEND=apps.ai.backends.keyword.KeywordBackend
HELPLY_AI_AUTO_TRIAGE_THRESHOLD=0.6
HELPLY_AI_AUTO_ASSIGN=true
HELPLY_SLA_AT_RISK_RATIO=0.75
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Demo accounts' shared password (generated automatically if missing)
# HELPLY_DEMO_PASSWORD=

# Public demo through Cloudflare Tunnel (start-online.bat)
ONLINE_HOSTNAME=helply.work
CLOUDFLARE_TUNNEL_TOKEN=

# Production: where people reach Helply (used in email links)
# HELPLY_SITE_URL=https://helply.work

# Outgoing email through Brevo (SMTP relay; sending only - it cannot receive mail). Fill in your own values,
# never commit them. Test with:  python manage.py sendtestemail you@your-real-address.com
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=<Brevo SMTP login>
# EMAIL_HOST_PASSWORD=<Brevo SMTP key>
# DEFAULT_FROM_EMAIL=Helply IT Service Desk <helpdesk@helply.work>
# Never emailed (in-app notifications still appear): example.com/.org/.net and *.example, *.test, *.invalid, *.localhost.
# Add your own placeholder domains here, comma separated:
# HELPLY_EMAIL_BLOCKED_DOMAINS=
# Without a tunnel, listen on the office network instead of this computer only:
# HELPLY_LISTEN=0.0.0.0:8000
# DJANGO_ALLOWED_HOSTS=helpdesk.local,192.168.1.20
