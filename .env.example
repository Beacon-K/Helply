# Copy to .env and adjust. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave POSTGRES_DB unset for local SQLite; docker-compose sets it for you.
POSTGRES_DB=helply
POSTGRES_USER=helply
POSTGRES_PASSWORD=helply

HELPLY_AI_BACKEND=apps.ai.backends.keyword.KeywordBackend
HELPLY_AI_AUTO_TRIAGE_THRESHOLD=0.6
HELPLY_AI_AUTO_ASSIGN=true
HELPLY_SLA_AT_RISK_RATIO=0.75
